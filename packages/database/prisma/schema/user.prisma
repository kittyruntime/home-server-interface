model User {
  id                 String  @id @default(uuid())
  username           String  @unique
  password           String
  displayName        String?
  isAdmin            Boolean @default(false)
  isUserManager      Boolean @default(false)
  // Set on the seeded bootstrap admin so it can't be left on its known default
  // password indefinitely; cleared the moment the account changes its password.
  mustChangePassword Boolean @default(false)
  // Explicit, not implicit: whether this account should have a Samba account at
  // all. Default true keeps existing behaviour (every user gets one). Turning it
  // off stops syncSystemPassword's Samba half; it does not remove an account that
  // already exists — see docs/manage-without-hsi.md for that.
  sambaEnabled       Boolean @default(true)
  wallpaper          Json?
  preferences        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  groups           UserGroup[]
  placePermissions UserPlacePermission[]
  auditLogs        AuditLog[]
  shareLinks       ShareLink[] @relation("UserShareLinks")
  capabilities     UserCapability[]
}

model UserCapability {
  id         String   @id @default(uuid())
  userId     String
  capability String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, capability])
}

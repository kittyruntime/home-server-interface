model Place {
  id              String                @id @default(uuid())
  name            String
  path            String                @unique
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  /// Emoji shown instead of the folder icon; null keeps the folder icon.
  icon            String?
  groupPermissions GroupPlacePermission[] @relation("GroupPerms")
  userPermissions  UserPlacePermission[] @relation("UserPerms")
  share           Share?
}

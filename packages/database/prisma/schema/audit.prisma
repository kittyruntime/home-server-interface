model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "fs.delete", "system.formatDisk", "auth.login"
  target    String?  // primary affected resource (path, device name, username…)
  meta      String?  // JSON: sanitized input for context
  ip        String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  // How the action came in: "dashboard", or "mcp" for an AI assistant with an
  // access token (#138), whose id is kept even after the token is revoked.
  via       String   @default("dashboard")
  tokenId   String?
}

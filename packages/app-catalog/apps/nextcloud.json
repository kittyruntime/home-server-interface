{
  "id": "nextcloud",
  "name": "Nextcloud",
  "category": "Productivity",
  "tagline": "Your own cloud: files, calendar, contacts and more.",
  "description": "Nextcloud syncs files across your devices and adds calendars, contacts, notes and hundreds of apps. Runs with its own MariaDB database.",
  "website": "https://nextcloud.com",
  "image": "nextcloud:30-apache",
  "changelog": "https://nextcloud.com/changelog/",
  "webUiPort": 80,
  "ports": [{ "container": 80, "protocol": "tcp", "label": "Web UI", "hostDefault": 8082 }],
  "env": [
    { "key": "NEXTCLOUD_ADMIN_USER", "default": "admin", "prompt": "Administrator name", "required": true },
    { "key": "NEXTCLOUD_ADMIN_PASSWORD", "prompt": "Administrator password", "secret": true, "required": true },
    { "key": "NEXTCLOUD_TRUSTED_DOMAINS", "prompt": "Addresses used to reach it, space-separated (e.g. 192.168.1.10:8082 cloud.example.com)", "required": true },
    { "key": "MYSQL_HOST", "default": "db" },
    { "key": "MYSQL_DATABASE", "default": "nextcloud" },
    { "key": "MYSQL_USER", "default": "nextcloud" },
    { "key": "MYSQL_PASSWORD", "secret": true }
  ],
  "volumes": [
    { "target": "/var/www/html", "label": "Nextcloud and its files", "suggest": "place" }
  ],
  "services": [
    {
      "name": "db",
      "label": "MariaDB (database)",
      "image": "mariadb:11.4",
      "env": {
        "MARIADB_DATABASE": "nextcloud",
        "MARIADB_USER": "nextcloud",
        "MARIADB_PASSWORD": "{{MYSQL_PASSWORD}}",
        "MARIADB_RANDOM_ROOT_PASSWORD": "1"
      },
      "volumes": [{ "name": "db", "target": "/var/lib/mysql" }],
      "command": ["--transaction-isolation=READ-COMMITTED", "--binlog-format=ROW"]
    }
  ]
}

{
  "id": "immich",
  "name": "Immich",
  "category": "Media",
  "added": "2026-11-23",
  "tagline": "Photo and video backup from your phone, with search and faces.",
  "description": "Immich backs up the photos and videos of your phones and shows them on a timeline, with albums, sharing, maps, face recognition and search by content. Runs with its own PostgreSQL database, cache and machine learning service.",
  "website": "https://immich.app",
  "image": "ghcr.io/immich-app/immich-server:v3.4.2",
  "changelog": "https://github.com/immich-app/immich/releases",
  "license": "AGPL-3.0",
  "source": "https://github.com/immich-app/immich",
  "docs": "https://docs.immich.app/",
  "postInstall": [
    "Open it and create the administrator account; the first start takes a few minutes.",
    "Install the mobile app, sign in with this server's address and turn on backup.",
    "Photos and videos are stored in the Library folder chosen at install."
  ],
  "webUiPort": 2283,
  "ports": [
    {
      "container": 2283,
      "protocol": "tcp",
      "label": "Web UI"
    }
  ],
  "env": [
    {
      "key": "DB_HOSTNAME",
      "default": "database"
    },
    {
      "key": "DB_USERNAME",
      "default": "postgres"
    },
    {
      "key": "DB_DATABASE_NAME",
      "default": "immich"
    },
    {
      "key": "DB_PASSWORD",
      "secret": true
    },
    {
      "key": "REDIS_HOSTNAME",
      "default": "redis"
    },
    {
      "key": "IMMICH_MACHINE_LEARNING_URL",
      "default": "http://machine-learning:3003"
    },
    {
      "key": "TZ",
      "default": "Etc/UTC",
      "prompt": "Time zone (e.g. Europe/Paris)"
    }
  ],
  "volumes": [
    {
      "target": "/data",
      "label": "Library (photos and videos)",
      "suggest": "place"
    }
  ],
  "services": [
    {
      "name": "database",
      "label": "PostgreSQL (database)",
      "image": "ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23",
      "env": {
        "POSTGRES_PASSWORD": "{{DB_PASSWORD}}",
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "immich",
        "POSTGRES_INITDB_ARGS": "--data-checksums"
      },
      "volumes": [
        {
          "name": "db",
          "target": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "name": "redis",
      "label": "Valkey (cache)",
      "image": "docker.io/valkey/valkey:9.1.2"
    },
    {
      "name": "machine-learning",
      "label": "Machine learning (search and faces)",
      "image": "ghcr.io/immich-app/immich-machine-learning:v3.4.2",
      "env": {
        "MACHINE_LEARNING_MODEL_REVISION": "v2"
      },
      "volumes": [
        {
          "name": "model-cache",
          "target": "/cache"
        }
      ]
    }
  ]
}

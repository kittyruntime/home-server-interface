{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kittyruntime/home-server-interface-apps/schema/app-manifest.v1.json",
  "title": "HSI App Store manifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Media",
        "Productivity",
        "Network",
        "Downloads",
        "Developer",
        "Utilities"
      ]
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tagline": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "pattern": "^https:\\/\\/.*"
    },
    "changelog": {
      "type": "string",
      "pattern": "^https:\\/\\/.*"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{2,40}$"
    },
    "source": {
      "type": "string",
      "pattern": "^https:\\/\\/.*"
    },
    "docs": {
      "type": "string",
      "pattern": "^https:\\/\\/.*"
    },
    "postInstall": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "webUiPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "ports": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "container": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "default": "tcp",
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "label": {
            "type": "string"
          },
          "hostDefault": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "container",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "env": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "default": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "secret": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    "volumes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^\\/.*"
          },
          "label": {
            "type": "string"
          },
          "suggest": {
            "default": "place",
            "type": "string",
            "enum": [
              "place",
              "named",
              "bind"
            ]
          },
          "readOnlyDefault": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "target",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "restartPolicy": {
      "default": "unless-stopped",
      "type": "string",
      "enum": [
        "no",
        "always",
        "unless-stopped",
        "on-failure"
      ]
    },
    "services": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,30}$"
          },
          "label": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "volumes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "target": {
                  "type": "string",
                  "pattern": "^\\/.*"
                }
              },
              "required": [
                "name",
                "target"
              ],
              "additionalProperties": false
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "label",
          "image"
        ],
        "additionalProperties": false
      }
    },
    "icon": {
      "type": "string",
      "description": "SVG logo, inline"
    },
    "minHsiVersion": {
      "type": "string",
      "pattern": "^v?\\d+\\.\\d+\\.\\d+$",
      "description": "Oldest HSI that can install this app"
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "added",
    "tagline",
    "description",
    "image"
  ],
  "additionalProperties": false
}

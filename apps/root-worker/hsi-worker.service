# Reference copy. scripts/install.sh generates the real unit.
[Unit]
Description=hsi worker (root)
Documentation=https://github.com/kittyruntime/home-server-interface
After=network.target hsi-nats.service
Requires=hsi-nats.service
PartOf=hsi.target

[Service]
ExecStart=/usr/local/bin/hsi-worker
User=root
# Credentials are read from this file at runtime.
# Create /etc/hsi/worker.env with:
#   NATS_URL=nats://127.0.0.1:4222
#   NATS_USER=worker
#   NATS_PASS=<password matching nats.conf>
EnvironmentFile=/etc/hsi/worker.env
# NoNewPrivileges must be off: the worker uses setresuid to impersonate users.
NoNewPrivileges=no
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/hsi/root-worker.log
StandardError=append:/var/log/hsi/root-worker.log
SyslogIdentifier=hsi-worker

[Install]
WantedBy=hsi.target
